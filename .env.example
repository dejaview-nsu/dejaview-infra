# ==========================================
# Images
# ==========================================
POSTGRES_TAG=16.11
QDRANT_TAG=v1.19.1
MINIO_TAG=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_TAG=RELEASE.2025-08-13T08-35-41Z
CERTBOT_TAG=v5.8.0

BACKEND_TAG=latest
FRONTEND_TAG=latest
ML_TAG=latest

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=dejaview
POSTGRES_USER=dejaview
POSTGRES_PASSWORD=
POSTGRES_PORT=57432

# ==========================================
# Qdrant
# ==========================================
QDRANT_PORT=57433
QDRANT_API_KEY=

# ==========================================
# MinIO
# ==========================================
MINIO_BUCKET=profile-photos
MINIO_ROOT_USER=dejaview
MINIO_ROOT_PASSWORD=
MINIO_PORT=57434
MINIO_CONSOLE_PORT=57435

# ==========================================
# Backend
# ==========================================
BACKEND_PORT=57436

# deploy.sh and rollback.sh require APP_URL, SMTP_URL, and SMTP_FROM.
APP_URL=
API_URL=

SMTP_URL=
# Plain email address only; display names such as DejaView <mail@example.com> are not supported.
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

SMARTCAPTCHA_SERVER_KEY=

OIDC_YANDEX_CLIENT_ID=
OIDC_YANDEX_CLIENT_SECRET=

OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

OIDC_VK_CLIENT_ID=

# Optional: override the ML service URL.
# By default backend uses http://ml:8000 inside the Docker network.
# ML_URL=https://your-ml-server.example.com

# ==========================================
# ML
# ==========================================
ML_DEVICE=auto
ML_IMAGE_ENABLED=true
ML_VIDEO_ENABLED=true
ML_TEXT_ENABLED=false
ML_AUDIO_ENABLED=false
ML_TOP_K=20

# Relevance thresholds are applied per modality. A numeric value enables a threshold,
# "none" disables it explicitly, and an empty value keeps the ML service default.
# ML_SCORE_THRESHOLD=
# ML_SCORE_THRESHOLD_TEXT=none
# ML_SCORE_THRESHOLD_IMAGE=0.8614
# ML_SCORE_THRESHOLD_VIDEO=0.9743
# ML_SCORE_THRESHOLD_AUDIO=0.8297

# ==========================================
# Frontend
# ==========================================
# VITE_API_BASE_URL is set to /api/v1 when the frontend image is built.
# VITE_* variables cannot be changed at runtime through this Compose file.
FRONTEND_PORT=57437
