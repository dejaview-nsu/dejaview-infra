# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=dejaview
POSTGRES_USER=dejaview
POSTGRES_PASSWORD=dejaview_local_only
POSTGRES_PORT=5432

# ==========================================
# Qdrant
# ==========================================
QDRANT_PORT=6333

# ==========================================
# Redis
# ==========================================
REDIS_PORT=6379

# ==========================================
# MinIO
# ==========================================
MINIO_ROOT_USER=dejaview
MINIO_ROOT_PASSWORD=dejaview_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==========================================
# Backend
# ==========================================
BACKEND_PORT=8081

# Default inference URL inside the Docker network:
# http://ml:8000
#
# To use a shared remote ML service, uncomment and
# configure the following variable:
# INFERENCE_URL=https://your-ml-server.example.com

